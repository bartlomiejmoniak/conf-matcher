{
  "name": "confgraph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Search interface for scientific conferences: plain-language search, deadline countdowns, venue comparison, watchlist and per-paper submission tracking.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "validate": "node scripts/validate.mjs",
    "build:venues": "node scripts/build-venues.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
